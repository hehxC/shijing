# 石境环境变量模板。
# 复制为 .env 后填写真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，请勿把真实密钥提交进仓库。
# 标注「必填」的变量在对应功能启用时必须设置；其余变量有代码内默认值，可省略。

# ============ 运行环境 ============
# 运行环境：development / testing / production
APP_ENV=development
# 应用启动时是否自动执行数据库迁移。
# 生产环境默认关闭（迁移由 scripts/migrate.py 在发布时单独执行），可显式覆盖。
# AUTO_MIGRATE=false
# 应用日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ============ 数据库 ============
# MySQL 连接串（必填）
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/shijing?charset=utf8mb4

# ============ 登录认证 ============
# 登录令牌签名密钥；生产环境务必替换为足够长的随机字符串（必填）
AUTH_SECRET_KEY=请替换为随机密钥
# 令牌有效期（秒），默认 7 天
AUTH_TOKEN_TTL_SECONDS=604800

# ============ 模型服务 ============
# 文本/主聊天模型（DeepSeek）
TEXT_CHAT_MODEL=deepseek-chat
DEEPSEEK_API_KEY=你的_DeepSeek_API_Key
# 意图路由模型（默认与文本模型解耦，固定 deepseek-chat）
ROUTER_MODEL=deepseek-chat
# 路由决策采集日志路径（用于攒评测样本，默认 data/router_decisions.jsonl）
# ROUTER_DECISION_LOG_PATH=data/router_decisions.jsonl

# 视觉模型（通义千问）
IMAGE_CHAT_MODEL=qwen-vl-max-latest
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=你的_DashScope_API_Key
# RAG 向量化模型
EMBEDDING_MODEL=text-embedding-v4

# 效果图生成提供商：qwen-image（千问图像生成与编辑，国内，文生图+图生图，默认）或 gemini（图生图，国外）
IMAGE_GENERATION_PROVIDER=qwen-image
# qwen-image 走 DashScope 的 DASHSCOPE_API_KEY
QWEN_IMAGE_MODEL=qwen-image-3.0-pro
QWEN_IMAGE_SIZE=1920*1080
# gemini 配置（IMAGE_GENERATION_PROVIDER=gemini 时生效）
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/interactions
GEMINI_KEY=你的_Gemini_API_Key
# 单次生成提示词最多携带的石材图数量
IMAGE_PROMPT_MATERIAL_LIMIT=24

# 模型价格集中配置（JSON）；未配置时仍记录调用，只把估算成本留空。
# 文本模型按每百万 Token 计价，图片模型可用 {"per_call":"0.03"}
# MODEL_PRICING_JSON={"deepseek-chat":{"input_per_million":"1","output_per_million":"2"},"gemini-3.1-flash-image":{"per_call":"0.03"}}

# ============ 图片存储 ============
# 存储后端：local（本地文件系统）/ s3（S3 兼容，含 MinIO、阿里云 OSS）
IMAGE_STORE=local
# local 模式的根目录
IMAGE_STORE_ROOT=data/images
# s3 模式（IMAGE_STORE=s3 时必填 S3_BUCKET；桶需预先创建）
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# S3_BUCKET=shijing-images
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1
# S3_PREFIX=prod

# ============ 知识检索（RAG） ============
# RAG 本项目未实际使用（仅测试），默认关闭；设 true 才启用知识检索
ENABLE_RAG=false
CHROMA_COLLECTION=garden_knowledge
CHROMA_PERSIST_DIR=data/chroma
# 检索 top-k 与相关度阈值
RETRIEVE_TOP_K=3
RETRIEVE_MAX_DISTANCE=1.30

# ============ AI 超时与有限重试 ============
AI_INTENT_ROUTING_TIMEOUT_SECONDS=10
AI_INTENT_ROUTING_MAX_RETRIES=1
AI_TEXT_CHAT_TIMEOUT_SECONDS=60
AI_TEXT_CHAT_MAX_RETRIES=1
AI_SQL_QUERY_TIMEOUT_SECONDS=15
AI_SQL_QUERY_MAX_RETRIES=1
AI_RAG_RETRIEVAL_TIMEOUT_SECONDS=5
AI_RAG_RETRIEVAL_MAX_RETRIES=0
AI_RAG_EMBEDDING_TIMEOUT_SECONDS=5
AI_RAG_EMBEDDING_MAX_RETRIES=0
AI_VISION_ANALYSIS_TIMEOUT_SECONDS=90
AI_VISION_ANALYSIS_MAX_RETRIES=1
AI_IMAGE_GENERATION_TIMEOUT_SECONDS=240
AI_IMAGE_GENERATION_MAX_RETRIES=1
AI_RETRY_BACKOFF_SECONDS=0.5

# ============ 用户级限流与生成额度 ============
# 限流后端：memory（单实例，进程内）/ redis（多实例共享状态）
RATE_LIMIT_BACKEND=memory
# RATE_LIMIT_BACKEND=redis 时的连接地址
# REDIS_URL=redis://localhost:6379/0
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_HOUR=5
CHAT_RATE_LIMIT_PER_MINUTE=10
VISION_RATE_LIMIT_PER_MINUTE=3
EFFECT_GENERATION_CONCURRENCY=1
EFFECT_GENERATION_DAILY_LIMIT=10
IMAGE_UPLOAD_RATE_LIMIT_PER_MINUTE=10
IDEMPOTENCY_TTL_SECONDS=86400

# ============ Docker Compose（本地编排时使用） ============
# MYSQL_ROOT_PASSWORD=root
# MYSQL_PASSWORD=shijing

# ============ 可选：LangSmith 追踪 ============
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=你的_LangSmith_API_Key
# LANGSMITH_PROJECT=shijing
